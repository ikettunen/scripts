# Scripts Environment Configuration (Cloud/Production)
# This file is used when running reset-all-data.js on EC2

# MySQL Configuration (EC2 localhost - MySQL running on same instance)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=nursing_home_db

# MongoDB Configuration (EC2 localhost - MongoDB running on same instance)
MONGODB_URI=mongodb://localhost:27017/nursing_home_visits

# Oracle HR Configuration (Optional - if using Oracle)
ORACLE_USER=C##HRAPP1
ORACLE_PASSWORD=hrapp123
ORACLE_CONNECT_STRING=localhost:1521/XE

# Environment
NODE_ENV=production
CLOUD_DEPLOYMENT=true

